{
  "name": "lianban-archive-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && node scripts/prepare-build.mjs && vite build && node scripts/build-info.mjs",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src scripts *.ts *.js *.json",
    "format:check": "prettier --check src scripts *.ts *.js tsconfig.json .prettierrc.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "echarts": "6.1.0",
    "element-plus": "2.14.7",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "16.5.0",
    "happy-dom": "20.14.6",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-vue-components": "30.0.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  }
}
